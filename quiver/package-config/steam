#!/bin/bash
# Archer config file

echo -e "Creating desktop entry to enable h264 codec in Steam"

mkdir -p /home/"$user"/.config/autostart/
chown "$user":"$user" /home/"$user"/.config/autostart/
chmod 755 /home/"$user"/.config/autostart/

cat <<END >>/home/"$user"/.config/autostart/h264-steam.desktop
[Desktop Entry]
Exec=bash -c 'if [ -f "\$HOME/.config/autostart/.h264-steam-marker" ]; then steam steam://unlockh264/; rm -f "\$HOME/.config/autostart"/{.h264-steam-marker,h264-steam.desktop}; else touch "\$HOME/.config/autostart/.h264-steam-marker" && steam steam://unlockh264/; fi'
Icon=/usr/share/pixmaps/archlinux-logo.png
StartupNotify=true
Type=Application
END
chown "$user":"$user" /home/"$user"/.config/autostart/h264-steam.desktop
chmod +x /home/"$user"/.config/autostart/h264-steam.desktop